# Uncomment this line to define a global platform for your project
platform :ios, '18.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    # cupertino_native_better ships Swift that only emits warnings under the
    # Swift 5 language mode but hard-errors under Swift 6 (Sendable checks).
    # Pin it to Swift 5 so it builds on the current Xcode/Swift toolchain.
    if target.name == 'cupertino_native_better'
      target.build_configurations.each do |config|
        config.build_settings['SWIFT_VERSION'] = '5.0'
      end
    end
    # awesome_notifications (IosAwnCore) forces BUILD_LIBRARY_FOR_DISTRIBUTION,
    # which CocoaPods propagates onto the Runner app target. Runner uses an
    # Objective-C bridging header, and Xcode rejects a bridging header together
    # with a Swift module interface ("bridging headers with module interfaces
    # is unsupported"). None of these app-embedded frameworks need library
    # evolution, so turn it off everywhere.
    target.build_configurations.each do |config|
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
    end
  end

  # The setting above only touches the Pods project's build settings; the
  # Runner target reads BUILD_LIBRARY_FOR_DISTRIBUTION from the *generated*
  # xcconfigs (e.g. Pods-Runner.debug.xcconfig, which CocoaPods sets to YES
  # because IosAwnCore requests it). Flip those to NO too.
  Dir.glob(File.join(installer.sandbox.root, 'Target Support Files', '**', '*.xcconfig')).each do |xcconfig|
    contents = File.read(xcconfig)
    if contents.include?('BUILD_LIBRARY_FOR_DISTRIBUTION = YES')
      File.write(
        xcconfig,
        contents.gsub('BUILD_LIBRARY_FOR_DISTRIBUTION = YES', 'BUILD_LIBRARY_FOR_DISTRIBUTION = NO'),
      )
    end
  end
end
